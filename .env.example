# ==============================================================================
# AI Career Intelligence Platform - Production & Development Environment Config
# ==============================================================================

# Core App Settings
ENVIRONMENT="development"
DEBUG=True
APP_SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","https://*.run.app"]'

# 1. AWS RDS PostgreSQL Configuration
# Format: postgresql+asyncpg://<username>:<password>@<rds-host-or-proxy>:<port>/<dbname>
AWS_RDS_POSTGRES_URL="postgresql+asyncpg://postgres:YourSecureRdsPassword@career-intelligence-db.c7x8y9z0.us-east-1.rds.amazonaws.com:5432/career_intelligence_db"
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
ENABLE_DB_FALLBACK=True  # Enables in-memory SQLite / mock fallback when RDS is unreachable in local dev

# 2. Azure Cosmos DB Configuration (SQL / Core API)
AZURE_COSMOS_ENDPOINT="https://career-intel-cosmos.documents.azure.com:443/"
AZURE_COSMOS_KEY="your-primary-cosmos-db-read-write-master-key=="
AZURE_COSMOS_DATABASE_NAME="CareerIntelligence"
AZURE_COSMOS_CONTAINER_NAME="AIInteractions"
AZURE_COSMOS_PARTITION_KEY="/user_id"
ENABLE_COSMOS_FALLBACK=True  # Enables local resilient async store when Azure Cosmos is unconfigured

# 3. Google Firebase Admin SDK (Real-Time Broadcast / Firestore)
# Path to service account JSON file, or inline JSON string
FIREBASE_CREDENTIALS_PATH="/path/to/firebase-service-account.json"
FIREBASE_DATABASE_URL="https://career-intel-platform-default-rtdb.firebaseio.com"
FIREBASE_PROJECT_ID="career-intel-platform"
ENABLE_FIREBASE_FALLBACK=True  # Enables simulated event broadcasting & logging when credentials are unset

# 4. Google Gemini AI Layer
# API key injected at runtime from Google AI Studio / GCP Secret Manager
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"

# Host & Port for Uvicorn
HOST="0.0.0.0"
PORT=8000
